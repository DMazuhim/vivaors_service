{
  "kind": "collectionType",
  "collectionName": "itineraries",
  "info": {
    "singularName": "itinerary",
    "pluralName": "itineraries",
    "displayName": "itinerary"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titlle": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "resume": {
      "type": "richtext"
    },
    "readTime": {
      "type": "string"
    },
    "coverMobile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "coverDesktop": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "coverCard": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "forms": {
      "type": "component",
      "component": "lead.form",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "meta.seo",
      "repeatable": false
    },
    "editorSignature": {
      "type": "enumeration",
      "enum": [
        "inicio-da-pagina",
        "final-da-pagina"
      ]
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "mappedBy": "itineraries"
    },
    "components": {
      "type": "dynamiczone",
      "components": [
        "section.itineraries",
        "section.places-page",
        "section.page-break",
        "section.categories-pages",
        "section.locations-page",
        "section.locations-map",
        "section.highlights-page",
        "section.highlights-guide-v2",
        "section.banners-page",
        "media.single-image",
        "media.popup",
        "cta.button",
        "lead.form",
        "content.widget",
        "content.text",
        "section.experiences",
        "content.text-experience",
        "content.text-itinerary",
        "content.text-guide",
        "content.text-location"
      ]
    },
    "locations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::location.location",
      "mappedBy": "itineraries"
    }
  }
}