{
  "kind": "collectionType",
  "collectionName": "locations",
  "info": {
    "singularName": "location",
    "pluralName": "locations",
    "displayName": "location"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "city",
        "route",
        "region",
        "neighborhood"
      ]
    },
    "lat": {
      "type": "string"
    },
    "lng": {
      "type": "string"
    },
    "bannerMobile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "bannerDesktop": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "blocks"
    },
    "label": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "seo": {
      "type": "component",
      "component": "meta.seo",
      "repeatable": false
    },
    "experiences": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::experience.experience",
      "mappedBy": "locations"
    }
  }
}
