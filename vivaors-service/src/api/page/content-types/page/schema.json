{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "campanha",
        "agenda",
        "pagina",
        "blog"
      ]
    },
    "popup": {
      "type": "component",
      "component": "media.popup",
      "repeatable": false
    },
    "seo": {
      "type": "component",
      "component": "meta.seo",
      "repeatable": false
    },
    "coverDesktop": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "coverMobile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "components": {
      "type": "dynamiczone",
      "components": [
        "section.trails",
        "section.places-page",
        "section.page-break",
        "section.categories-pages",
        "section.locations-page",
        "section.locations-map",
        "section.highlights",
        "section.highlights-page",
        "section.highlights-guide-v2",
        "section.banners-page",
        "section.banner-full",
        "media.single-image",
        "media.popup",
        "media.gallery",
        "media.banner-marketing",
        "media.banner-campaign",
        "cta.button",
        "lead.form",
        "content.widget",
        "content.text"
      ]
    }
  }
}
