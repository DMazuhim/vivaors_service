{
  "collectionName": "components_sections_highlights_pages",
  "info": {
    "displayName": "Destaques de página",
    "description": ""
  },
  "options": {},
  "attributes": {
    "highlights": {
      "type": "component",
      "repeatable": true,
      "component": "section.highlights"
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "translate": {
          "translate": "translate"
        }
      }
    },
    "location": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::location.location"
    },
    "titleSize": {
      "type": "enumeration",
      "enum": [
        "grande",
        "medio",
        "pequeno"
      ],
      "default": "medio"
    },
    "redirectUrl": {
      "type": "string"
    }
  }
}
